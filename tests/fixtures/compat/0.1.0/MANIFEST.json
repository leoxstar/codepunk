  "captureCommands": [
    "npm install codepunk-cli@0.1.0 --prefix {{NPM_PREFIX}}",
    "env CODEPUNK_HOME={{HOME}} node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js models import --provider compat --base-url {{COMPAT_BASE_URL}} --api-key {{COMPAT_API_KEY}} --model compat-model",
    "env CODEPUNK_HOME={{HOME}} node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js models set compat/compat-model",
    "script -q /dev/null env CODEPUNK_HOME={{HOME}} node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js --cwd {{PROJECT}}",
    "  First compat conversation turn: write compat-written.txt and report success.",
    "  Second compat conversation turn: write compat-written.txt and report success.",
    "  !pwd > denied-shell.txt; approval menu: Deny",
    "  !pwd > approved-shell.txt; approval menu: Allow once",
    "  /undo; confirmation: Yes",
    "  /compact",
    "env CODEPUNK_HOME={{HOME}} node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js --cwd {{PROJECT}} --fork compat-parent",
    "script -q /dev/null env CODEPUNK_HOME={{HOME}} node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js --cwd {{PROJECT}} --model compat-sign/compat-model --session compat-sign-session",
    "  Run one shell command to write compat-sign.txt and report success.; approval menu: Allow once",
    "  /sign complete",
    "env CODEPUNK_HOME={{HOME}} node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js mcp add compat-auth --url http://127.0.0.1:48762/mcp",
    "env CODEPUNK_HOME={{HOME}} node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js mcp logout compat-auth",
    "script -q {{HOME}}/../tui-model-history.script.log env CODEPUNK_HOME={{HOME}} PI_OFFLINE=1 TERM=xterm-256color node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js",
    "  /model compat/compat-model",
    "  /favorite",
    "  /quit",
    "env CODEPUNK_COMPAT_CORE_ROOT={{CORE_PACKAGE_ROOT}} node scripts/collect-compat-0.1.0.mjs (runs published codepunk-core@0.1.0 twice in clean child processes and deterministically normalizes only the random notification ULID suffix)",
    "script -q {{HOME}}/../tui-subagent.script.log env CODEPUNK_HOME={{HOME}} PI_OFFLINE=1 TERM=xterm-256color node {{NPM_PREFIX}}/node_modules/codepunk-cli/dist/index.js",
    "  /subagent --profile reviewer reply with exactly COMPAT_CHILD_OK",
    "  /quit"
  ],
