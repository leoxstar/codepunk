{
  "name": "codepunk-cli",
  "version": "0.1.1",
  "description": "Terminal surface, approvals, arguments, and exit codes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoxstar/codepunk.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codepunk": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && node build.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-mcp": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "devDependencies": {
    "codepunk-core": "workspace:*",
    "codepunk-protocol": "workspace:*",
    "esbuild": "catalog:"
  }
}
